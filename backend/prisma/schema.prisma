generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id              String         @id @default(cuid())
  firstName       String
  lastName        String
  email           String         @unique
  password        String
  role            String         @default("employee") // admin, operator, driver
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  address         String?
  phone           String?
  identityCard    String?        @unique
  isActive        Boolean        @default(true)
  trackingConsent Boolean        @default(false)
  resetPasswordToken String?
  resetPasswordExpires DateTime?
  dispatches      Dispatch[]
  trips           Trip[]
  notifications   Notification[]

  @@index([email])
  @@map("employees")
}

model Notification {
  id              String   @id @default(cuid())
  recipientId     String
  title           String
  message         String
  type            String
  isRead          Boolean  @default(false)
  relatedEntityId String?
  relatedEntity   String?
  createdAt       DateTime @default(now())
  recipient       Employee @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@map("notifications")
}

model SystemSetting {
  id                   String    @id @default(cuid())
  maintenanceMode      Boolean   @default(false)
  maintenanceScheduled DateTime?
  maintenanceMessage   String?
  updatedAt            DateTime  @updatedAt

  @@map("system_settings")
}

model AuditLog {
  id          String   @id @default(cuid())
  entity      String
  entityId    String
  action      String
  performedBy String
  details     String
  ip          String?
  timestamp   DateTime @default(now())

  @@index([entityId])
  @@index([timestamp])
  @@map("audit_logs")
}

// ============================================================================
// MODULO DE LOGISTICA Y TRAZABILIDAD DE DESPACHOS
// ============================================================================

model Farm {
  id        String     @id @default(cuid())
  name      String
  location  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  dispatches Dispatch[]

  @@map("log_farms")
}

model Destination {
  id          String     @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  dispatches  Dispatch[]

  @@map("log_destinations")
}

model Dispatch {
  id             String             @id @default(cuid())
  dispatchCode   String             @unique
  farmId         String
  farm           Farm               @relation(fields: [farmId], references: [id])
  destinationId  String
  destination    Destination        @relation(fields: [destinationId], references: [id])
  date           DateTime
  responsibleId  String
  responsible    Employee           @relation(fields: [responsibleId], references: [id])
  observations   String?
  status         String             @default("Creado") // Creado, Preparación, En carga, Despachado, Finalizado
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  boxes          Box[]
  trips          Trip[]
  documents      LogisticDocument[]

  @@index([farmId])
  @@index([destinationId])
  @@index([responsibleId])
  @@map("log_dispatches")
}

model Box {
  id         String    @id @default(cuid())
  boxCode    String    @unique
  qrCode     String?   @unique
  dispatchId String
  dispatch   Dispatch  @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  status     String    @default("Pendiente") // Pendiente, Cargada, En tránsito, Entregada, Faltante
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  scans      BoxScan[]

  @@index([dispatchId])
  @@map("log_boxes")
}

model Vehicle {
  id        String   @id @default(cuid())
  plate     String   @unique
  brand     String?
  model     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  trips     Trip[]

  @@map("log_vehicles")
}

model Trip {
  id                 String               @id @default(cuid())
  driverId           String
  driver             Employee             @relation(fields: [driverId], references: [id])
  vehicleId          String
  vehicle            Vehicle              @relation(fields: [vehicleId], references: [id])
  dispatchId         String
  dispatch           Dispatch             @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  date               DateTime
  time               String
  status             String               @default("Asignado") // Asignado, En finca, En tránsito, Llegado a aeropuerto, Finalizado
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  history            TripStatusHistory[]
  gpsPositions       GpsPosition[]
  temperatureReadings TemperatureReading[]

  @@index([driverId])
  @@index([vehicleId])
  @@index([dispatchId])
  @@map("log_trips")
}

model TripStatusHistory {
  id         String   @id @default(cuid())
  tripId     String
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  status     String
  changedBy  String
  changedAt  DateTime @default(now())
  notes      String?

  @@index([tripId])
  @@map("log_trip_status_history")
}

model BoxScan {
  id        String   @id @default(cuid())
  boxId     String
  box       Box      @relation(fields: [boxId], references: [id], onDelete: Cascade)
  scannedBy String
  scannedAt DateTime @default(now())
  latitude  Float?
  longitude Float?
  status    String   // Cargada, Pendiente, Faltante

  @@index([boxId])
  @@map("log_box_scans")
}

model GpsPosition {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  latitude  Float
  longitude Float
  timestamp DateTime @default(now())

  @@index([tripId])
  @@map("log_gps_positions")
}

model TemperatureReading {
  id          String   @id @default(cuid())
  tripId      String
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  temperature Float
  timestamp   DateTime @default(now())

  @@index([tripId])
  @@map("log_temperature_readings")
}

model LogisticDocument {
  id           String   @id @default(cuid())
  dispatchId   String
  dispatch     Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  type         String   // Guía de despacho, Documentos logísticos, Evidencias, Guía firmada
  fileUrl      String
  originalName String?
  uploadedBy   String
  createdAt    DateTime @default(now())

  @@index([dispatchId])
  @@map("log_documents")
}
